<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist for the macOS VST3 bundle.

  A macOS host does not dlopen the plugin: it opens the .vst3 directory with
  CFBundle, reads this file to find the executable, and calls bundleEntry. So
  this is not decoration -- without it CFBundleCreate fails and the plugin is
  invisible to every host.

  CFBundleExecutable must be the name of the file in Contents/MacOS, and
  CFBundlePackageType must stay BNDL: some hosts (and macOS itself) look at it
  before they will treat the directory as a loadable bundle.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>S-MU2000</string>
	<key>CFBundleIdentifier</key>
	<string>com.tarboh.smu2000.vst3</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>S-MU2000</string>
	<key>CFBundleDisplayName</key>
	<string>S-MU2000</string>
	<key>CFBundlePackageType</key>
	<string>BNDL</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>0.1.0.0</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CSResourcesFileMapped</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
